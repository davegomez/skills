diff --git a/QuickNotesUITests/DeepLinkUITests.swift b/QuickNotesUITests/DeepLinkUITests.swift
new file mode 100644
index 0000000..0cce94d
--- /dev/null
+++ b/QuickNotesUITests/DeepLinkUITests.swift
@@ -0,0 +1,38 @@
+import XCTest
+
+@MainActor
+final class DeepLinkUITests: XCTestCase {
+    private var app: XCUIApplication!
+    private let groceriesLink = URL(string: "quicknotes://notes/11111111-1111-1111-1111-111111111111/archive")!
+
+    override func setUp() async throws {
+        continueAfterFailure = false
+        app = XCUIApplication()
+        app.launchArguments = ["-uitest-seed"]
+        app.launch()
+    }
+
+    func testLinkShowsPreviewAndCancelKeepsNote() {
+        app.open(groceriesLink)
+        XCTAssertTrue(app.buttons["archive-preview.confirm"].waitForExistence(timeout: 10))
+        app.buttons["archive-preview.cancel"].tap()
+        XCTAssertTrue(app.staticTexts["Groceries"].waitForExistence(timeout: 5))
+    }
+
+    func testConfirmArchivesNote() {
+        app.open(groceriesLink)
+        XCTAssertTrue(app.buttons["archive-preview.confirm"].waitForExistence(timeout: 10))
+        app.buttons["archive-preview.confirm"].tap()
+        XCTAssertTrue(app.staticTexts["Groceries"].waitForNonExistence(timeout: 5))
+        app.buttons["Archived"].tap()
+        XCTAssertTrue(app.staticTexts["Groceries"].waitForExistence(timeout: 5))
+    }
+
+    func testInvalidLinkShowsNoPreview() {
+        app.open(URL(string: "quicknotes://notes/not-a-note/archive")!)
+        XCTAssertTrue(app.alerts.firstMatch.waitForExistence(timeout: 5))
+        XCTAssertFalse(app.buttons["archive-preview.confirm"].exists)
+        app.alerts.firstMatch.buttons.firstMatch.tap()
+        XCTAssertTrue(app.staticTexts["Groceries"].waitForExistence(timeout: 5))
+    }
+}
