new file mode 100644
index 0000000..1f33348
--- /dev/null
+++ b/QuickNotes/ArchivePreviewView.swift
@@ -0,0 +1,35 @@
+import SwiftUI
+
+/// Asks the user to confirm archiving a note that a link named.
+struct ArchivePreviewView: View {
+    let note: Note
+    let onConfirm: () -> Void
+    let onCancel: () -> Void
+
+    var body: some View {
+        NavigationStack {
+            Form {
+                Section {
+                    Text(note.title)
+                        .font(.headline)
+                    Text(note.body)
+                        .foregroundStyle(.secondary)
+                } footer: {
+                    Text("The note moves to Archived. You can unarchive it from there.")
+                }
+            }
+            .navigationTitle("Archive Note?")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) {
+                    Button("Cancel", action: onCancel)
+                        .accessibilityIdentifier("archive-preview.cancel")
+                }
+                ToolbarItem(placement: .confirmationAction) {
+                    Button("Archive", action: onConfirm)
+                        .accessibilityIdentifier("archive-preview.confirm")
+                }
+            }
+        }
+    }
+}
diff --git a/QuickNotes/DeepLink.swift b/QuickNotes/DeepLink.swift
new file mode 100644
index 0000000..b280dec
--- /dev/null
+++ b/QuickNotes/DeepLink.swift
@@ -0,0 +1,25 @@
+import Foundation
+
+/// A link the app accepts. Every other URL is rejected.
+enum DeepLink: Equatable {
+    /// `quicknotes://notes/<note-id>/archive`
+    case archivePreview(noteID: UUID)
+
+    private static let maxLength = 256
+
+    /// Parses an untrusted URL. Returns nil unless it matches a documented format exactly.
+    init?(url: URL) {
+        guard url.absoluteString.count <= Self.maxLength,
+              url.scheme?.lowercased() == "quicknotes",
+              url.host(percentEncoded: true) == "notes",
+              url.user == nil, url.password == nil, url.port == nil,
+              url.query == nil, url.fragment == nil
+        else { return nil }
+
+        let segments = url.path(percentEncoded: true).split(separator: "/", omittingEmptySubsequences: false)
+        guard segments.count == 3, segments[0].isEmpty, segments[2] == "archive",
+              segments[1].count == 36, let noteID = UUID(uuidString: String(segments[1]))
+        else { return nil }
+        self = .archivePreview(noteID: noteID)
+    }
+}
