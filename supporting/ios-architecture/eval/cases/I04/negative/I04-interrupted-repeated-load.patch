@@ -0,0 +1,70 @@
+import Foundation
+import OrdersData
+import OrdersDomain
+import Testing
+
+struct LiveOrdersLoaderTests {
+    /// Bytes that version 1.0 of the app wrote.
+    static let oldCache = #"{"lines":[{"name":"Desk lamp","qty":1,"sku":"C3","unit_price_cents":10000}],"saved_at":1767225600.512345,"version":1}"#
+
+    let directory: URL
+    let cacheURL: URL
+
+    init() throws {
+        directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        cacheURL = directory.appendingPathComponent("ledger/orders-cache.json")
+    }
+
+    private func loader(feed: String?) -> LiveOrdersLoader {
+        let endpoint = feed.map { URL(string: "data:application/json;base64," + Data($0.utf8).base64EncodedString())! }
+            ?? directory.appendingPathComponent("missing-feed.json")
+        return LiveOrdersLoader(endpoint: endpoint, cacheURL: cacheURL, now: { Date(timeIntervalSince1970: 1_800_000_000) })
+    }
+
+    private func writeCache(_ text: String) throws {
+        try FileManager.default.createDirectory(at: cacheURL.deletingLastPathComponent(), withIntermediateDirectories: true)
+        try Data(text.utf8).write(to: cacheURL)
+    }
+
+    @Test func readsCacheWrittenByOldVersion() throws {
+        try writeCache(Self.oldCache)
+        #expect(loader(feed: nil).savedLines() == [OrderLine(sku: "C3", name: "Desk lamp", quantity: 1, unitPriceCents: 10000)])
+    }
+
+    @Test func noCacheGivesNil() {
+        #expect(loader(feed: nil).savedLines() == nil)
+    }
+
+    @Test(arguments: [String(Self.oldCache.prefix(57)), "", #"{"lines":[],"saved_at":1,"version":2}"#])
+    func unreadableCacheGivesNil(_ text: String) throws {
+        try writeCache(text)
+        #expect(loader(feed: nil).savedLines() == nil)
+    }
+
+    @Test func refreshSavesInTheLegacyFormat() async throws {
+        let lines = try await loader(feed: #"{"lines":[{"sku":"A1","name":"Notebook","qty":2,"unit_price_cents":1250}]}"#).refresh()
+        #expect(lines == [OrderLine(sku: "A1", name: "Notebook", quantity: 2, unitPriceCents: 1250)])
+        let saved = try String(contentsOf: cacheURL, encoding: .utf8)
+        #expect(saved == #"{"lines":[{"name":"Notebook","qty":2,"sku":"A1","unit_price_cents":1250}],"saved_at":1800000000,"version":1}"#)
+    }
+
+    @Test func refreshReplacesInsteadOfAppending() async throws {
+        let loader = loader(feed: #"{"lines":[{"sku":"A1","name":"Notebook","qty":2,"unit_price_cents":1250}]}"#)
+        _ = try await loader.refresh()
+        _ = try await loader.refresh()
+        #expect(loader.savedLines()?.count == 1)
+    }
+
+    @Test func failedRefreshKeepsTheCache() async throws {
+        try writeCache(Self.oldCache)
+        await #expect(throws: (any Error).self) { try await loader(feed: nil).refresh() }
+        #expect(loader(feed: nil).savedLines()?.first?.sku == "C3")
+    }
+
+    @Test func malformedFeedThrowsAndKeepsTheCache() async throws {
+        try writeCache(Self.oldCache)
+        await #expect(throws: (any Error).self) { try await loader(feed: #"{"lines":"#).refresh() }
+        #expect(loader(feed: nil).savedLines()?.first?.sku == "C3")
+    }
+}
