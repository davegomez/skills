+import Foundation
+import OrdersData
+
+extension LiveOrdersLoader {
+    /// The loader the app uses. QA builds point the screen at a staging or canned feed.
+    static func app(environment: [String: String] = ProcessInfo.processInfo.environment) -> LiveOrdersLoader {
+        if let override = environment["LEDGER_ORDERS_URL"], let url = URL(string: override) {
+            return LiveOrdersLoader(endpoint: url)
+        }
+        return LiveOrdersLoader(endpoint: URL(string: "https://api.ledger.example/v1/orders")!)
+    }
+}
