@@ -0,0 +1,21 @@
+/// One line of an order. The coding keys are the server and cache format; users' saved data depends on them.
+public struct OrderLine: Codable, Equatable, Sendable {
+    public var sku: String
+    public var name: String
+    public var quantity: Int
+    public var unitPriceCents: Int
+
+    public init(sku: String, name: String, quantity: Int, unitPriceCents: Int) {
+        self.sku = sku
+        self.name = name
+        self.quantity = quantity
+        self.unitPriceCents = unitPriceCents
+    }
+
+    enum CodingKeys: String, CodingKey {
+        case sku
+        case name
+        case quantity = "qty"
+        case unitPriceCents = "unit_price_cents"
+    }
+}
