new file mode 100644
index 0000000..0759ee6
--- /dev/null
+++ b/LedgerOrders/Sources/OrdersDomain/OrderTotals.swift
@@ -0,0 +1,21 @@
+/// The totals of an order, in cents.
+public struct OrderTotals: Equatable, Sendable {
+    public let subtotal: Int
+    public let discount: Int
+    public let tax: Int
+
+    public var total: Int { subtotal - discount + tax }
+
+    /// Lines with a quantity of 0 or less do not count. Orders of $100.00 or more get 10% off.
+    /// Sales tax is 8.25% of the discounted amount. Both round half up to the cent.
+    public init(lines: [OrderLine]) {
+        let subtotal = lines
+            .filter { $0.quantity > 0 }
+            .reduce(0) { $0 + $1.quantity * $1.unitPriceCents }
+        let discount = subtotal >= 10_000 ? (subtotal + 5) / 10 : 0
+        let taxable = subtotal - discount
+        self.subtotal = subtotal
+        self.discount = discount
+        self.tax = (taxable * 825 + 5_000) / 10_000
+    }
+}
