+import OrdersDomain
+import Testing
+
+/// Characterization of the totals that OrdersViewController computed before the extraction.
+struct OrderTotalsTests {
+    struct Example: Sendable, CustomTestStringConvertible {
+        let name: String
+        let lines: [OrderLine]
+        let subtotal, discount, tax, total: Int
+        var testDescription: String { name }
+    }
+
+    static let examples = [
+        Example(name: "empty", lines: [], subtotal: 0, discount: 0, tax: 0, total: 0),
+        Example(name: "under the threshold",
+                lines: [line("A1", 2, 1250), line("B2", 1, 399)],
+                subtotal: 2899, discount: 0, tax: 239, total: 3138),
+        Example(name: "exactly at the threshold",
+                lines: [line("C3", 1, 10000)],
+                subtotal: 10000, discount: 1000, tax: 743, total: 9743),
+        Example(name: "zero and negative quantities do not count",
+                lines: [line("D4", 3, 4999), line("E5", -1, 4999), line("F6", 0, 500)],
+                subtotal: 14997, discount: 1500, tax: 1114, total: 14611),
+        Example(name: "discount rounds half up",
+                lines: [line("G7", 1, 10005)],
+                subtotal: 10005, discount: 1001, tax: 743, total: 9747),
+        Example(name: "tax rounds half up",
+                lines: [line("H8", 4, 50)],
+                subtotal: 200, discount: 0, tax: 17, total: 217),
+        Example(name: "just under the threshold",
+                lines: [line("I9", 1, 9999)],
+                subtotal: 9999, discount: 0, tax: 825, total: 10824),
+    ]
+
+    @Test(arguments: examples)
+    func totals(_ example: Example) {
+        let totals = OrderTotals(lines: example.lines)
+        #expect(totals.subtotal == example.subtotal)
+        #expect(totals.discount == example.discount)
+        #expect(totals.tax == example.tax)
+        #expect(totals.total == example.total)
+    }
+
+    private static func line(_ sku: String, _ quantity: Int, _ cents: Int) -> OrderLine {
+        OrderLine(sku: sku, name: sku, quantity: quantity, unitPriceCents: cents)
+    }
+}
