diff --git a/LedgerOrders/Sources/OrdersData/OrdersLoading.swift b/LedgerOrders/Sources/OrdersData/OrdersLoading.swift
new file mode 100644
index 0000000..755fd63
--- /dev/null
+++ b/LedgerOrders/Sources/OrdersData/OrdersLoading.swift
@@ -0,0 +1,99 @@
+import Foundation
+import OrdersDomain
+import OSLog
+
+/// The data-loading seam of the orders screen.
+public protocol OrdersLoading: Sendable {
+    /// The lines that the last successful load saved, or nil when no readable cache exists.
+    func savedLines() -> [OrderLine]?
+
+    /// Loads the lines from the server and saves them. Throws when the load fails; the saved lines stay.
+    func refresh() async throws -> [OrderLine]
+}
+
+public enum OrdersLoadError: Error, Equatable {
+    case status(Int)
+}
+
+/// Loads orders over HTTP and keeps the last result in the cache file that every app version reads.
+public struct LiveOrdersLoader: OrdersLoading {
+    /// `Application Support/ledger/orders-cache.json`. Do not move it: users' saved orders live there.
+    public static var defaultCacheURL: URL {
+        FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("ledger", isDirectory: true)
+            .appendingPathComponent("orders-cache.json")
+    }
+
+    private let endpoint: URL
+    private let cacheURL: URL
+    private let session: URLSession
+    private let now: @Sendable () -> Date
+    private let logger = Logger(subsystem: "com.example.ledger", category: "orders")
+
+    public init(
+        endpoint: URL,
+        cacheURL: URL = LiveOrdersLoader.defaultCacheURL,
+        session: URLSession = .shared,
+        now: @escaping @Sendable () -> Date = { Date() }
+    ) {
+        self.endpoint = endpoint
+        self.cacheURL = cacheURL
+        self.session = session
+        self.now = now
+    }
+
+    public func savedLines() -> [OrderLine]? {
+        guard let data = try? Data(contentsOf: cacheURL) else { return nil }
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .secondsSince1970
+        guard let cache = try? decoder.decode(OrdersCacheFile.self, from: data),
+              cache.version == OrdersCacheFile.currentVersion
+        else { return nil }
+        return cache.lines
+    }
+
+    public func refresh() async throws -> [OrderLine] {
+        let (data, response) = try await session.data(from: endpoint)
+        if let http = response as? HTTPURLResponse, !(200..<300).contains(http.statusCode) {
+            throw OrdersLoadError.status(http.statusCode)
+        }
+        let lines = try JSONDecoder().decode(OrdersResponse.self, from: data).lines
+        // A failed save keeps the loaded lines on screen, as before; the next load retries it.
+        do {
+            try save(lines)
+        } catch {
+            logger.error("Could not save the orders cache: \(error.localizedDescription, privacy: .public)")
+        }
+        return lines
+    }
+
+    private func save(_ lines: [OrderLine]) throws {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .secondsSince1970
+        encoder.outputFormatting = [.sortedKeys]
+        let cache = OrdersCacheFile(version: OrdersCacheFile.currentVersion, savedAt: now(), lines: lines)
+        try FileManager.default.createDirectory(
+            at: cacheURL.deletingLastPathComponent(), withIntermediateDirectories: true
+        )
+        try encoder.encode(cache).write(to: cacheURL, options: .atomic)
+    }
+}
+
+/// The cache file format. Its keys and version are read by every installed app version.
+struct OrdersCacheFile: Codable {
+    static let currentVersion = 1
+
+    var version: Int
+    var savedAt: Date
+    var lines: [OrderLine]
+
+    enum CodingKeys: String, CodingKey {
+        case version
+        case savedAt = "saved_at"
+        case lines
+    }
+}
+
+private struct OrdersResponse: Decodable {
+    var lines: [OrderLine]
+}
