  "traps": [
    {
      "id": "I05-trap-personal-data-log",
      "file": "Guestbook/Store/GuestStore.swift",
      "line": 49,
      "severity": "critical",
      "priority": "security",
      "description": "The check-in log interpolates the guest's name and email with privacy: .public, so synthetic personal data reaches the unified log unredacted.",
      "cause": ["log|logger|logging|logged|os_log", "e-?mail|name|personal|pii|privacy|private|public|redact|sensitive"]
    },
    {
      "id": "I05-trap-discarded-write",
      "file": "Guestbook/Store/GuestStore.swift",
      "line": 73,
      "severity": "major",
      "priority": "reliability",
      "description": "try? discards the failure of the door-ledger file write; the ledger silently misses check-ins and the user is never told, unlike persist().",
      "cause": ["try\\?|discard|swallow|ignor|silent|suppress|unhandled|not handled|lost|drop", "writ|save|ledger|disk|file|i/o|persist|error|fail"]
    },
    {
      "id": "I05-trap-inaccessible-gesture",
      "file": "Guestbook/Views/GuestListView.swift",
      "line": 19,
      "severity": "major",
      "priority": "accessibility",
      "description": "Check-in is reachable only through onTapGesture(count: 2) with no button, swipe action, or accessibility action; VoiceOver, Voice Control, and Switch Control users cannot check guests in.",
      "cause": ["accessib|voiceover|voice control|switch control|assistive|a11y", "gesture|tap|double|action"]
    }
  ],
