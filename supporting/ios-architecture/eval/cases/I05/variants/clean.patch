     private(set) var guests: [Guest] = []
     var lastError: StoreError?
     private let fileURL: URL
+    private let ledgerURL: URL
 
     init(directory: URL = .documentsDirectory) {
         fileURL = directory.appending(path: "guests.json")
+        ledgerURL = directory.appending(path: "door-ledger.csv")
+    }
+
+    var checkedInCount: Int {
+        guests.count(where: { $0.checkedInAt != nil })
     }
 
     func load() {
@@ -30,7 +36,22 @@ final class GuestStore {
 
     func remove(_ guest: Guest) {
         guests.removeAll { $0.id == guest.id }
+        AppLog.store.info("Removed guest \(guest.id, privacy: .private(mask: .hash))")
         persist()
+        writeLedger()
+    }
+
+    /// Checks a guest in at the door, or undoes the check-in.
+    func toggleCheckIn(_ guest: Guest) {
+        guard let index = guests.firstIndex(where: { $0.id == guest.id }) else { return }
+        if guests[index].checkedInAt == nil {
+            guests[index].checkedInAt = .now
+            AppLog.store.info("Checked in guest \(guest.id, privacy: .private(mask: .hash))")
+        } else {
+            guests[index].checkedInAt = nil
+        }
+        persist()
+        writeLedger()
     }
 
     private func persist() {
@@ -42,4 +63,18 @@ final class GuestStore {
             lastError = .saveFailed
         }
     }
+
+    /// Rewrites the door ledger that staff export after the event: 1 row per checked-in guest.
+    private func writeLedger() {
+        let rows = guests.compactMap { guest in
+            guest.checkedInAt.map { "\(guest.id.uuidString),\($0.ISO8601Format())" }
+        }
+        let data = Data(rows.joined(separator: "\n").utf8)
+        do {
+            try data.write(to: ledgerURL, options: [.atomic, .completeFileProtection])
+        } catch {
+            AppLog.store.error("Door ledger not saved: \(String(describing: type(of: error)), privacy: .public)")
+            lastError = .saveFailed
+        }
+    }
 }
