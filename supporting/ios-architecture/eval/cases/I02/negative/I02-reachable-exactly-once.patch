+// swift-tools-version: 6.4
+import PackageDescription
+
+// Swift packages do not inherit the concurrency settings of the app target.
+let concurrency: [SwiftSetting] = [
+    .enableUpcomingFeature("NonisolatedNonsendingByDefault"),
+    .enableUpcomingFeature("InferIsolatedConformances"),
+]
+let mainActor = concurrency + [.defaultIsolation(MainActor.self)]
+
+let package = Package(
+    name: "OrderSummary",
+    defaultLocalization: "en",
+    // The macOS entry lets `swift test` run on the development Mac.
+    platforms: [.iOS("27.3"), .macOS("27.3")],
+    products: [
+        .library(name: "OrderSummaryDomain", targets: ["OrderSummaryDomain"]),
+        .library(name: "OrderSummaryFeature", targets: ["OrderSummaryFeature"]),
+    ],
+    dependencies: [
+        .package(path: "../../Core"),
+        .package(path: "../../DesignSystem"),
+    ],
+    targets: [
+        // Pure domain: keep the nonisolated default.
+        .target(name: "OrderSummaryDomain", swiftSettings: concurrency),
+        .target(
+            name: "OrderSummaryFeature",
+            dependencies: [
+                "OrderSummaryDomain",
+                .product(name: "FeatureKit", package: "Core"),
+                .product(name: "CoreClients", package: "Core"),
+                .product(name: "DesignSystem", package: "DesignSystem"),
+            ],
+            resources: [.process("Resources")],
+            swiftSettings: mainActor
+        ),
+        .testTarget(
+            name: "OrderSummaryDomainTests",
+            dependencies: ["OrderSummaryDomain", .product(name: "CoreClients", package: "Core")],
+            swiftSettings: concurrency
+        ),
+        .testTarget(
+            name: "OrderSummaryFeatureTests",
+            dependencies: ["OrderSummaryFeature", .product(name: "CoreTesting", package: "Core")],
+            swiftSettings: mainActor
+        ),
+    ],
+    swiftLanguageModes: [.v6]
+)
diff --git a/Packages/Features/OrderSummary/Sources/OrderSummaryDomain/OrderSummaryDomain.swift b/Packages/Features/OrderSummary/Sources/OrderSummaryDomain/OrderSummaryDomain.swift
new file mode 100644
index 0000000..ab4a9f0
--- /dev/null
+++ b/Packages/Features/OrderSummary/Sources/OrderSummaryDomain/OrderSummaryDomain.swift
@@ -0,0 +1,61 @@
+import Foundation
+
+/// 1 line of an order. Amounts are whole US cents, so sums are exact.
+public struct LineItem: Identifiable, Equatable, Sendable {
+    public static let quantityRange = 1...999
+    public static let unitPriceRange = 0...1_000_000
+
+    public let id: String
+    public let name: String
+    public let quantity: Int
+    public let unitPriceCents: Int
+
+    /// Rejects values outside the ranges, so totals cannot overflow or go negative.
+    public static func make(id: String, name: String, quantity: Int, unitPriceCents: Int) throws(OrderError) -> LineItem {
+        let trimmed = name.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { throw .emptyName }
+        guard quantityRange.contains(quantity) else { throw .quantityOutOfRange(quantity) }
+        guard unitPriceRange.contains(unitPriceCents) else { throw .priceOutOfRange(unitPriceCents) }
+        return LineItem(id: id, name: trimmed, quantity: quantity, unitPriceCents: unitPriceCents)
+    }
+
+    public var lineTotalCents: Int { quantity * unitPriceCents }
+}
+
+public enum OrderError: Error, Equatable, Sendable {
+    case emptyName
+    case quantityOutOfRange(Int)
+    case priceOutOfRange(Int)
+}
+
+public struct Order: Equatable, Sendable {
+    public let items: [LineItem]
+    public init(items: [LineItem]) { self.items = items }
+}
+
+public struct OrderTotals: Equatable, Sendable {
+    public let subtotalCents: Int
+    public let taxCents: Int
+    public let totalCents: Int
+}
+
+/// The sales tax rate in basis points: 825 is 8.25%.
+public let taxRateBasisPoints = 825
+
+/// Subtotal is the sum of the line totals. Tax is the subtotal times the rate, rounded to the nearest
+/// cent with half a cent rounded up. Total is the subtotal plus the tax.
+public func totals(of order: Order, taxRateBasisPoints rate: Int = taxRateBasisPoints) -> OrderTotals {
+    let subtotal = order.items.reduce(0) { $0 + $1.lineTotalCents }
+    let tax = roundHalfUp(subtotal * rate, divisor: 10_000)
+    return OrderTotals(subtotalCents: subtotal, taxCents: tax, totalCents: subtotal + tax)
+}
+
+/// Integer division of a non-negative value, rounding half up.
+func roundHalfUp(_ value: Int, divisor: Int) -> Int {
+    (value + divisor / 2) / divisor
+}
+
+/// The source of the current order. The app injects an implementation; this feature has only a fake.
+public protocol OrderService: Sendable {
+    func currentOrder() async throws -> Order
+}
diff --git a/Packages/Features/OrderSummary/Sources/OrderSummaryFeature/FakeOrderService.swift b/Packages/Features/OrderSummary/Sources/OrderSummaryFeature/FakeOrderService.swift
