+import FeatureKit
+import Foundation
+import OrderSummaryDomain
+import SwiftUI
+
+/// The only public type of the feature besides its fake service. The composition root registers it.
+nonisolated public struct OrderSummaryEntry: Feature {
+    private let service: any OrderService
+
+    public init(service: any OrderService) {
+        self.service = service
+    }
+
+    public var id: FeatureID { FeatureID("OrderSummary") }
+
+    public var metadata: FeatureMetadata {
+        FeatureMetadata(
+            title: LocalizedStringResource("Order summary", bundle: .atURL(Bundle.module.bundleURL)),
+            systemImage: "list.bullet.rectangle"
+        )
+    }
+
+    public var requirement: EntitlementRequirement { .none }
+
+    @MainActor
+    public func makeRootView(context: FeatureContext) -> AnyView {
+        AnyView(OrderSummaryView(model: OrderSummaryModel(service: service)))
+    }
+}
