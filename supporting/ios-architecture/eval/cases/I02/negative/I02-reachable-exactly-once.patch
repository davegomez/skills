diff --git a/Packages/Features/OrderSummary/Tests/OrderSummaryDomainTests/OrderSummaryDomainTests.swift b/Packages/Features/OrderSummary/Tests/OrderSummaryDomainTests/OrderSummaryDomainTests.swift
new file mode 100644
index 0000000..15e9b6f
--- /dev/null
+++ b/Packages/Features/OrderSummary/Tests/OrderSummaryDomainTests/OrderSummaryDomainTests.swift
@@ -0,0 +1,58 @@
+import Foundation
+import Testing
+@testable import OrderSummaryDomain
+
+private func item(_ quantity: Int, _ cents: Int) throws -> LineItem {
+    try LineItem.make(id: UUID().uuidString, name: "Item", quantity: quantity, unitPriceCents: cents)
+}
+
+@Test func lineTotalIsQuantityTimesUnitPrice() throws {
+    #expect(try item(3, 499).lineTotalCents == 1497)
+}
+
+@Test func sampleOrderTotals() throws {
+    let order = Order(items: [try item(3, 499), try item(1, 1249), try item(1, 1454)])
+    #expect(totals(of: order) == OrderTotals(subtotalCents: 4200, taxCents: 347, totalCents: 4547))
+}
+
+/// Tax rounds to the nearest cent, and half a cent rounds up (not to even).
+@Test(arguments: [
+    (4200, 347),  // 346.5 -> 347
+    (4600, 380),  // 379.5 -> 380
+    (1000, 83),   // 82.5 -> 83
+    (1010, 83),   // 83.325 -> 83
+    (1020, 84),   // 84.15 -> 84
+    (0, 0),
+])
+func taxRoundsHalfUp(subtotal: Int, tax: Int) throws {
+    let result = totals(of: Order(items: [try item(1, subtotal)]))
+    #expect(result.taxCents == tax)
+    #expect(result.totalCents == subtotal + tax)
+}
+
+@Test func emptyOrderHasZeroTotals() {
+    #expect(totals(of: Order(items: [])) == OrderTotals(subtotalCents: 0, taxCents: 0, totalCents: 0))
+}
+
+@Test(arguments: [0, -1, 1000])
+func makeRejectsQuantityOutOfRange(_ quantity: Int) {
+    #expect(throws: OrderError.quantityOutOfRange(quantity)) {
+        try LineItem.make(id: "a", name: "A", quantity: quantity, unitPriceCents: 100)
+    }
+}
+
+@Test(arguments: [-1, 1_000_001])
+func makeRejectsPriceOutOfRange(_ cents: Int) {
+    #expect(throws: OrderError.priceOutOfRange(cents)) {
+        try LineItem.make(id: "a", name: "A", quantity: 1, unitPriceCents: cents)
+    }
+}
+
+@Test func makeRejectsAnEmptyName() {
+    #expect(throws: OrderError.emptyName) { try LineItem.make(id: "a", name: "  ", quantity: 1, unitPriceCents: 1) }
+}
+
+@Test func largestOrderDoesNotOverflow() throws {
+    let order = Order(items: Array(repeating: try item(999, 1_000_000), count: 100))
+    #expect(totals(of: order).totalCents > totals(of: order).subtotalCents)
+}
diff --git a/Packages/Features/OrderSummary/Tests/OrderSummaryFeatureTests/OrderSummaryModelTests.swift b/Packages/Features/OrderSummary/Tests/OrderSummaryFeatureTests/OrderSummaryModelTests.swift
new file mode 100644
index 0000000..8a79146
--- /dev/null
+++ b/Packages/Features/OrderSummary/Tests/OrderSummaryFeatureTests/OrderSummaryModelTests.swift
@@ -0,0 +1,41 @@
+import Foundation
+import OrderSummaryDomain
+import Testing
+@testable import OrderSummaryFeature
+
+@Test func sampleLoadsTheOrderAndItsTotals() async throws {
+    let model = OrderSummaryModel(service: FakeOrderService(scenario: .sample))
+    await model.load()
+    let order = try FakeOrderService.sampleOrder()
+    #expect(model.phase == .loaded(order, totals(of: order)))
+    #expect(totals(of: order).totalCents == 4547)
+}
+
+@Test func emptyOrderShowsTheEmptyState() async {
+    let model = OrderSummaryModel(service: FakeOrderService(scenario: .empty))
+    await model.load()
+    #expect(model.phase == .empty)
+}
+
+@Test func failureShowsTheErrorStateAndRetryLoadsAgain() async {
+    let service = FlakyService()
+    let model = OrderSummaryModel(service: service)
+    await model.load()
+    #expect(model.phase == .failed)
+    await model.load()
+    #expect(model.phase == .empty)
+}
+
+@Test func dollarsFormatsWholeCents() {
+    #expect(dollars(4547).contains("45.47"))
+}
+
+/// Fails the first call, then returns an empty order.
+private actor FlakyService: OrderService {
+    private var calls = 0
+    func currentOrder() async throws -> Order {
+        calls += 1
+        if calls == 1 { throw FakeOrderService.LoadFailure() }
+        return Order(items: [])
+    }
+}
