@@ -0,0 +1,32 @@
+import Foundation
+import Observation
+import OrderSummaryDomain
+
+@Observable
+final class OrderSummaryModel {
+    enum Phase: Equatable {
+        case loading
+        case loaded(Order, OrderTotals)
+        case empty
+        case failed
+    }
+
+    private(set) var phase = Phase.loading
+    private let service: any OrderService
+
+    init(service: any OrderService) {
+        self.service = service
+    }
+
+    func load() async {
+        phase = .loading
+        do {
+            let order = try await service.currentOrder()
+            phase = order.items.isEmpty ? .empty : .loaded(order, totals(of: order))
+        } catch is CancellationError {
+            // The view went away; nothing to show.
+        } catch {
+            phase = .failed
+        }
+    }
+}
diff --git a/Packages/Features/OrderSummary/Sources/OrderSummaryFeature/OrderSummaryView.swift b/Packages/Features/OrderSummary/Sources/OrderSummaryFeature/OrderSummaryView.swift
new file mode 100644
index 0000000..e2743f4
--- /dev/null
+++ b/Packages/Features/OrderSummary/Sources/OrderSummaryFeature/OrderSummaryView.swift
@@ -0,0 +1,100 @@
+import DesignSystem
+import OrderSummaryDomain
+import SwiftUI
+
+struct OrderSummaryView: View {
+    @State var model: OrderSummaryModel
+
+    var body: some View {
+        content
+            .navigationTitle(Text("Order summary", bundle: .module))
+            .task { await model.load() }
+    }
+
+    @ViewBuilder
+    private var content: some View {
+        switch model.phase {
+        case .loading:
+            ProgressView { Text("Loading your order", bundle: .module) }
+        case .empty:
+            ContentUnavailableView {
+                Label { Text("Your order is empty.", bundle: .module) } icon: { Image(systemName: "cart") }
+            }
+        case .failed:
+            ContentUnavailableView {
+                Label { Text("We couldn't load your order.", bundle: .module) } icon: {
+                    Image(systemName: "exclamationmark.triangle")
+                }
+            } actions: {
+                Button { Task { await model.load() } } label: { Text("Try again", bundle: .module) }
+                    .buttonStyle(.borderedProminent)
+            }
+        case .loaded(let order, let totals):
+            List {
+                Section {
+                    ForEach(order.items) { item in
+                        LineItemRow(item: item)
+                    }
+                } header: {
+                    Text("Items", bundle: .module)
+                }
+                Section {
+                    AmountRow(title: Text("Subtotal", bundle: .module), cents: totals.subtotalCents)
+                        .accessibilityIdentifier("order.subtotal")
+                    AmountRow(title: Text("Tax (8.25%)", bundle: .module), cents: totals.taxCents)
+                        .accessibilityIdentifier("order.tax")
+                    AmountRow(title: Text("Total", bundle: .module), cents: totals.totalCents)
+                        .bold()
+                        .accessibilityIdentifier("order.total")
+                }
+            }
+        }
+    }
+}
+
+/// Formats whole cents as US dollars with the user's number format.
+func dollars(_ cents: Int) -> String {
+    (Decimal(cents) / 100).formatted(.currency(code: "USD"))
+}
+
+private struct LineItemRow: View {
+    let item: LineItem
+
+    var body: some View {
+        ViewThatFits(in: .horizontal) {
+            HStack(alignment: .firstTextBaseline) { details; Spacer(); total }
+            VStack(alignment: .leading) { details; total }
+        }
+        .accessibilityElement(children: .combine)
+    }
+
+    private var details: some View {
+        VStack(alignment: .leading) {
+            Text(item.name)
+            Text("\(item.quantity) × \(dollars(item.unitPriceCents))", bundle: .module)
+                .font(.subheadline)
+                .foregroundStyle(.secondary)
+        }
+    }
+
+    private var total: some View { Text(dollars(item.lineTotalCents)) }
+}
+
+private struct AmountRow: View {
+    let title: Text
+    let cents: Int
+
+    var body: some View {
+        ViewThatFits(in: .horizontal) {
+            HStack { title; Spacer(); Text(dollars(cents)) }
+            VStack(alignment: .leading) { title; Text(dollars(cents)) }
+        }
+        .accessibilityElement(children: .combine)
+    }
+}
+
+#Preview {
+    NavigationStack {
+        OrderSummaryView(model: OrderSummaryModel(service: FakeOrderService(scenario: .sample)))
+    }
+}
