@@ -0,0 +1,31 @@
+import Foundation
+import OrderSummaryDomain
+
+/// The only `OrderService` until a backend exists. The composition root picks the scenario.
+public struct FakeOrderService: OrderService {
+    public enum Scenario: String, Sendable {
+        case sample, empty, error
+    }
+
+    public struct LoadFailure: Error {}
+
+    private let scenario: Scenario
+    public init(scenario: Scenario) { self.scenario = scenario }
+
+    public func currentOrder() async throws -> Order {
+        switch scenario {
+        case .sample: return try Self.sampleOrder()
+        case .empty: return Order(items: [])
+        case .error: throw LoadFailure()
+        }
+    }
+
+    /// 3 x $4.99 + 1 x $12.49 + 1 x $14.54 = $42.00; tax 8.25% = $3.465, rounded half up to $3.47.
+    static func sampleOrder() throws -> Order {
+        Order(items: [
+            try LineItem.make(id: "notebook", name: "Notebook", quantity: 3, unitPriceCents: 499),
+            try LineItem.make(id: "pen-set", name: "Pen set", quantity: 1, unitPriceCents: 1249),
+            try LineItem.make(id: "desk-lamp", name: "Desk lamp", quantity: 1, unitPriceCents: 1454),
+        ])
+    }
+}
