+@testable import PackingFeature
+import PackingDomain
+
+@Test func addItemUsesTheInjectedID() {
+    let model = PackingModel(uuid: .incrementing(), store: InMemoryKeyValueStore())
+    #expect(model.addItem(title: " Socks "))
+    #expect(model.state.items.map(\.id.uuidString) == ["00000000-0000-0000-0000-000000000000"])
+    #expect(model.state.items.map(\.title) == ["Socks"])
+    #expect(model.errorMessage == nil)
+}
+
+@Test func emptyTitleShowsAnErrorUntilTheNextValidAdd() {
+    let model = PackingModel(uuid: .incrementing(), store: InMemoryKeyValueStore())
+    #expect(!model.addItem(title: "  "))
+    #expect(model.errorMessage != nil)
+    #expect(model.state.items.isEmpty)
+    #expect(model.addItem(title: "Hat"))
+    #expect(model.errorMessage == nil)
+}
+
+@Test func changesSurviveANewModelOnTheSameStore() async {
+    let store = InMemoryKeyValueStore()
+    let first = PackingModel(uuid: .incrementing(), store: store)
+    await first.load()
+    first.addItem(title: "Socks")
+    first.addItem(title: "Hat")
+    first.togglePacked(id: first.state.items[0].id)
+    await first.waitForSaves()
+
+    let second = PackingModel(uuid: .incrementing(), store: store)
+    await second.load()
+    #expect(second.state == first.state)
+    #expect(second.state.items.map(\.isPacked) == [true, false])
+}
+
+@Test func unreadableFileShowsAnError() async throws {
+    let store = InMemoryKeyValueStore()
+    try await store.set(Data("not json".utf8), forKey: PackingModel.storeKey)
+    let model = PackingModel(uuid: .incrementing(), store: store)
+    await model.load()
+    #expect(model.errorMessage != nil)
+    #expect(model.state.items.isEmpty)
+}
+
+@Test func failedSaveShowsAnError() async {
+    let model = PackingModel(uuid: .incrementing(), store: FailingStore())
+    model.addItem(title: "Socks")
+    await model.waitForSaves()
+    #expect(model.errorMessage != nil)
+}
+
+private struct FailingStore: KeyValueStore {
+    struct Failure: Error {}
+    func data(forKey key: String) async throws -> Data? { nil }
+    func set(_ data: Data?, forKey key: String) async throws { throw Failure() }
+}
