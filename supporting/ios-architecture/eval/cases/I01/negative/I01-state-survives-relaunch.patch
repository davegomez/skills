index 0000000..4f88327
--- /dev/null
+++ b/Packages/Persistence/Sources/Persistence/FileStore.swift
@@ -0,0 +1,41 @@
+import CoreClients
+import Foundation
+
+/// The live `KeyValueStore`: 1 file for each key, written atomically with a Data Protection class.
+/// It is an actor, so file work runs off the main actor and writes to 1 key do not overlap.
+public actor FileStore: KeyValueStore {
+    private let directory: URL
+    private let protection: Data.WritingOptions
+
+    /// `protection` is a Data Protection option, for example `.completeFileProtection`.
+    public init(directory: URL, protection: Data.WritingOptions) {
+        self.directory = directory
+        self.protection = protection
+    }
+
+    public func data(forKey key: String) throws -> Data? {
+        let url = try fileURL(for: key)
+        do {
+            return try Data(contentsOf: url)
+        } catch let error as CocoaError where error.code == .fileReadNoSuchFile {
+            return nil
+        }
+    }
+
+    public func set(_ data: Data?, forKey key: String) throws {
+        let url = try fileURL(for: key)
+        guard let data else {
+            do {
+                try FileManager.default.removeItem(at: url)
+            } catch let error as CocoaError where error.code == .fileNoSuchFile {}
+            return
+        }
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        try data.write(to: url, options: [.atomic, protection])
+    }
+
+    private func fileURL(for key: String) throws -> URL {
+        try KeyValueStoreError.validate(key)
+        return directory.appending(path: key, directoryHint: .notDirectory)
+    }
+}
diff --git a/Packages/Persistence/Tests/PersistenceTests/FileStoreTests.swift b/Packages/Persistence/Tests/PersistenceTests/FileStoreTests.swift
new file mode 100644
index 0000000..9d86632
--- /dev/null
+++ b/Packages/Persistence/Tests/PersistenceTests/FileStoreTests.swift
@@ -0,0 +1,39 @@
+import CoreClients
+import Foundation
+import Persistence
+import Testing
+
+/// A store in a new temporary folder on disk, so that the tests cover the live file system.
+/// The `complete` class fails while the device is locked, so the tests use a class that works on a locked Mac.
+private func makeStore() -> (FileStore, URL) {
+    let directory = FileManager.default.temporaryDirectory.appending(path: UUID().uuidString, directoryHint: .isDirectory)
+    return (FileStore(directory: directory, protection: .completeFileProtectionUntilFirstUserAuthentication), directory)
+}
+
+@Test func storesAndReadsData() async throws {
+    let (store, directory) = makeStore()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    try await store.set(Data("one".utf8), forKey: "value")
+    try await store.set(Data("two".utf8), forKey: "value")
+    #expect(try await store.data(forKey: "value") == Data("two".utf8))
+}
+
+@Test func missingKeyReadsNil() async throws {
+    let (store, _) = makeStore()
+    #expect(try await store.data(forKey: "missing") == nil)
+}
+
+@Test func settingNilRemovesTheValue() async throws {
+    let (store, directory) = makeStore()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    try await store.set(Data("one".utf8), forKey: "value")
+    try await store.set(nil, forKey: "value")
+    try await store.set(nil, forKey: "never-set")
+    #expect(try await store.data(forKey: "value") == nil)
+}
+
+@Test(arguments: ["", ".hidden", "../escape", "a/b"])
+func rejectsKeysOutsideTheFolder(_ key: String) async {
+    let (store, _) = makeStore()
+    await #expect(throws: KeyValueStoreError.invalidKey) { try await store.set(Data(), forKey: key) }
+}
