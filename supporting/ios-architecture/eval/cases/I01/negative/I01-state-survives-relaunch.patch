new file mode 100644
index 0000000..c7df506
--- /dev/null
+++ b/App/PackingList/AppShell/AppRoute.swift
@@ -0,0 +1,6 @@
+import FeatureKit
+
+/// Every destination of the root navigation stack. `Codable`, so that navigation state can be restored.
+nonisolated enum AppRoute: Hashable, Codable {
+    case feature(FeatureID)
+}
diff --git a/App/PackingList/AppShell/AppRouter.swift b/App/PackingList/AppShell/AppRouter.swift
new file mode 100644
index 0000000..8a0db4f
--- /dev/null
+++ b/App/PackingList/AppShell/AppRouter.swift
@@ -0,0 +1,12 @@
+import FeatureKit
+import Observation
+
+/// The navigation state of the shell: the selected feature and the stack of routes on top of it.
+@Observable
+final class AppRouter {
+    var selection: FeatureID?
+    var path: [AppRoute] = []
+
+    func open(_ route: AppRoute) { path.append(route) }
+    func popToRoot() { path.removeAll() }
+}
