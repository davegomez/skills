diff --git a/Packages/Networking/Sources/Networking/LiveHTTPClient.swift b/Packages/Networking/Sources/Networking/LiveHTTPClient.swift
new file mode 100644
index 0000000..3c1744b
--- /dev/null
+++ b/Packages/Networking/Sources/Networking/LiveHTTPClient.swift
@@ -0,0 +1,93 @@
+import CoreClients
+import Foundation
+
+/// The live `HTTPClient`: 1 `URLSession`, validated responses, and retries of idempotent requests
+/// with exponential backoff and jitter.
+public struct LiveHTTPClient: HTTPClient {
+    private let baseURL: URL
+    private let session: URLSession
+    private let clock: any Clock<Duration>
+    private let uuid: UUIDGenerator
+    private let diagnostics: any DiagnosticsClient
+    private let maxAttempts: Int
+    private let maxResponseBytes: Int
+    private let jitter: @Sendable (Duration) -> Duration
+
+    public init(
+        baseURL: URL,
+        session: URLSession = .shared,
+        clock: any Clock<Duration> = ContinuousClock(),
+        uuid: UUIDGenerator = .live,
+        diagnostics: any DiagnosticsClient,
+        maxAttempts: Int = 3,
+        maxResponseBytes: Int = 10_000_000,
+        jitter: @escaping @Sendable (Duration) -> Duration = { $0 * Double.random(in: 0.5...1) }
+    ) {
+        precondition(maxAttempts >= 1, "maxAttempts must be 1 or more")
+        self.baseURL = baseURL
+        self.session = session
+        self.clock = clock
+        self.uuid = uuid
+        self.diagnostics = diagnostics
+        self.maxAttempts = maxAttempts
+        self.maxResponseBytes = maxResponseBytes
+        self.jitter = jitter
+    }
+
+    public func send<Response: Decodable & Sendable>(_ endpoint: Endpoint<Response>) async throws -> Response {
+        let requestID = uuid().uuidString
+        let request = try makeRequest(endpoint, requestID: requestID)
+        var attempt = 1
+        while true {
+            try Task.checkCancellation()
+            do {
+                return try await sendOnce(request, requestID: requestID)
+            } catch let error as HTTPError where error.isRetryable && endpoint.isIdempotent && attempt < maxAttempts {
+                try await clock.sleep(for: jitter(.milliseconds(200) * (1 << (attempt - 1))))
+                attempt += 1
+            }
+        }
+    }
+
+    private func makeRequest<Response>(_ endpoint: Endpoint<Response>, requestID: String) throws -> URLRequest {
+        var components = URLComponents(url: baseURL.appending(path: endpoint.path), resolvingAgainstBaseURL: false)
+        if !endpoint.query.isEmpty { components?.queryItems = endpoint.query }
+        guard let url = components?.url else { throw HTTPError.invalidURL }
+        var request = URLRequest(url: url)
+        request.httpMethod = endpoint.method.rawValue
+        request.httpBody = endpoint.body
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        if endpoint.body != nil { request.setValue("application/json", forHTTPHeaderField: "Content-Type") }
+        request.setValue(requestID, forHTTPHeaderField: "X-Request-ID")
+        return request
+    }
+
+    private func sendOnce<Response: Decodable & Sendable>(_ request: URLRequest, requestID: String) async throws -> Response {
+        let data: Data
+        let response: URLResponse
+        do {
+            (data, response) = try await session.data(for: request)
+        } catch let error as URLError where error.code == .cancelled {
+            throw CancellationError()
+        } catch let error as URLError {
+            diagnostics.record(.httpTransportFailure(requestID: requestID, code: error.code.rawValue))
+            throw HTTPError.transport(error.code)
+        }
+        guard let http = response as? HTTPURLResponse else { throw HTTPError.invalidResponse }
+        diagnostics.record(.httpResponse(requestID: requestID, status: http.statusCode))
+        guard (200..<300).contains(http.statusCode) else { throw HTTPError.status(http.statusCode) }
+        guard http.mimeType == "application/json" else { throw HTTPError.unexpectedContentType }
+        // shortcut: the size check runs after the download; stream with bytes(for:) when bodies can be large.
+        guard data.count <= maxResponseBytes else { throw HTTPError.responseTooLarge }
+        do {
+            return try await Self.decode(Response.self, from: data)
+        } catch {
+            throw HTTPError.malformedBody
+        }
+    }
+
+    @concurrent
+    private static func decode<Response: Decodable & Sendable>(_ type: Response.Type, from data: Data) async throws -> Response {
+        try JSONDecoder().decode(type, from: data)
+    }
+}
diff --git a/Packages/Networking/Tests/NetworkingTests/LiveHTTPClientTests.swift b/Packages/Networking/Tests/NetworkingTests/LiveHTTPClientTests.swift
new file mode 100644
index 0000000..0a2d013
--- /dev/null
+++ b/Packages/Networking/Tests/NetworkingTests/LiveHTTPClientTests.swift
@@ -0,0 +1,128 @@
+import CoreClients
+import CoreTesting
+import Foundation
+import Networking
+import os
+import Testing
+
+private struct Item: Decodable, Equatable, Sendable {
+    let id: Int
+}
+
+private typealias Reply = @Sendable (URLRequest) throws -> (Int, String, Data)
+
+/// Answers requests from a reply that each test registers for its own host, so tests can run in parallel.
+private final class StubURLProtocol: URLProtocol {
+    static let replies = OSAllocatedUnfairLock(initialState: [String: Reply]())
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+    override func stopLoading() {}
+
+    override func startLoading() {
+        guard let url = request.url, let reply = Self.replies.withLock({ $0[url.host() ?? ""] }) else {
+            client?.urlProtocol(self, didFailWithError: URLError(.unsupportedURL))
+            return
+        }
+        do {
+            let (status, contentType, body) = try reply(request)
+            let response = HTTPURLResponse(url: url, statusCode: status, httpVersion: nil, headerFields: ["Content-Type": contentType])!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: body)
+            client?.urlProtocolDidFinishLoading(self)
+        } catch {
+            client?.urlProtocol(self, didFailWithError: error)
+        }
+    }
+}
+
+/// A client whose requests go to `reply`, with no waiting between retries.
+private func makeClient(maxResponseBytes: Int = 1_000, reply: @escaping Reply) -> LiveHTTPClient {
+    let host = "\(UUID().uuidString.lowercased()).test"
+    StubURLProtocol.replies.withLock { $0[host] = reply }
+    let configuration = URLSessionConfiguration.ephemeral
+    configuration.protocolClasses = [StubURLProtocol.self]
+    return LiveHTTPClient(
+        baseURL: URL(string: "https://\(host)")!,
+        session: URLSession(configuration: configuration),
+        clock: ImmediateClock(),
+        uuid: .incrementing(),
+        diagnostics: NoOpDiagnostics(),
+        maxResponseBytes: maxResponseBytes,
+        jitter: { $0 }
+    )
+}
+
+private func counter() -> OSAllocatedUnfairLock<Int> { OSAllocatedUnfairLock(initialState: 0) }
+
+private let json = "application/json"
+
+@Test func decodesValidResponseAndIgnoresUnknownFields() async throws {
+    let client = makeClient { request in
+        #expect(request.value(forHTTPHeaderField: "X-Request-ID") == "00000000-0000-0000-0000-000000000000")
+        return (200, json, Data(#"{"id": 7, "extra": true}"#.utf8))
+    }
+    #expect(try await client.send(Endpoint<Item>(path: "items/7")) == Item(id: 7))
+}
+
+@Test(arguments: [400, 401, 404])
+func clientErrorIsNotRetried(_ status: Int) async {
+    let calls = counter()
+    let client = makeClient { _ in
+        calls.withLock { $0 += 1 }
+        return (status, json, Data())
+    }
+    await #expect(throws: HTTPError.status(status)) { try await client.send(Endpoint<Item>(path: "items")) }
+    #expect(calls.withLock { $0 } == 1)
+}
+
+@Test func serverErrorIsRetriedThenSucceeds() async throws {
+    let calls = counter()
+    let client = makeClient { _ in
+        let call = calls.withLock { count in
+            count += 1
+            return count
+        }
+        return call < 3 ? (503, json, Data()) : (200, json, Data(#"{"id": 1}"#.utf8))
+    }
+    #expect(try await client.send(Endpoint<Item>(path: "items/1")) == Item(id: 1))
+}
+
+@Test func timeoutStopsAfterMaxAttempts() async {
+    let client = makeClient { _ in throw URLError(.timedOut) }
+    await #expect(throws: HTTPError.transport(.timedOut)) { try await client.send(Endpoint<Item>(path: "items")) }
+}
+
+@Test func postIsNotRetried() async {
+    let calls = counter()
+    let client = makeClient { _ in
+        calls.withLock { $0 += 1 }
+        return (503, json, Data())
+    }
+    await #expect(throws: HTTPError.status(503)) {
+        try await client.send(Endpoint<Item>(.post, path: "items", body: Data("{}".utf8)))
+    }
+    #expect(calls.withLock { $0 } == 1)
+}
+
+@Test func malformedBodyFails() async {
+    let client = makeClient { _ in (200, json, Data("not json".utf8)) }
+    await #expect(throws: HTTPError.malformedBody) { try await client.send(Endpoint<Item>(path: "items")) }
+}
+
+@Test func unexpectedContentTypeFails() async {
+    let client = makeClient { _ in (200, "text/html", Data("<html>".utf8)) }
+    await #expect(throws: HTTPError.unexpectedContentType) { try await client.send(Endpoint<Item>(path: "items")) }
+}
+
+@Test func responseOverSizeLimitFails() async {
+    let client = makeClient(maxResponseBytes: 8) { _ in (200, json, Data(#"{"id": 1234567}"#.utf8)) }
+    await #expect(throws: HTTPError.responseTooLarge) { try await client.send(Endpoint<Item>(path: "items")) }
+}
+
+@Test func cancelledTaskStops() async {
+    let client = makeClient { _ in (503, json, Data()) }
+    let task = Task { try await client.send(Endpoint<Item>(path: "items")) }
+    task.cancel()
+    await #expect(throws: CancellationError.self) { try await task.value }
+}
