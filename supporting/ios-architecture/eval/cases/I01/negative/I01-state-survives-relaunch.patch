new file mode 100644
index 0000000..5fc101c
--- /dev/null
+++ b/Packages/Core/Sources/CoreClients/HTTPClient.swift
@@ -0,0 +1,53 @@
+import Foundation
+
+/// Sends typed endpoints. The live implementation is in the `Networking` package.
+public protocol HTTPClient: Sendable {
+    func send<Response: Decodable & Sendable>(_ endpoint: Endpoint<Response>) async throws -> Response
+}
+
+/// 1 request: method, path, query, body, and the expected response type.
+public struct Endpoint<Response: Decodable & Sendable>: Sendable {
+    public enum Method: String, Sendable {
+        case get = "GET", put = "PUT", post = "POST", patch = "PATCH", delete = "DELETE"
+    }
+
+    public let method: Method
+    public let path: String
+    public let query: [URLQueryItem]
+    public let body: Data?
+
+    public init(_ method: Method = .get, path: String, query: [URLQueryItem] = [], body: Data? = nil) {
+        self.method = method
+        self.path = path
+        self.query = query
+        self.body = body
+    }
+
+    /// Only idempotent requests are retried.
+    public var isIdempotent: Bool {
+        switch method {
+        case .get, .put, .delete: true
+        case .post, .patch: false
+        }
+    }
+}
+
+/// Expected HTTP failures. Map them to user-facing messages in the feature layer.
+public enum HTTPError: Error, Equatable, Sendable {
+    case invalidURL
+    case invalidResponse
+    case status(Int)
+    case unexpectedContentType
+    case responseTooLarge
+    case malformedBody
+    case transport(URLError.Code)
+
+    /// A later attempt can succeed.
+    public var isRetryable: Bool {
+        switch self {
+        case .transport: true
+        case .status(let code): code == 408 || code == 429 || code >= 500
+        default: false
+        }
+    }
+}
diff --git a/Packages/Core/Sources/CoreClients/KeyValueStore.swift b/Packages/Core/Sources/CoreClients/KeyValueStore.swift
new file mode 100644
index 0000000..fe08e31
--- /dev/null
+++ b/Packages/Core/Sources/CoreClients/KeyValueStore.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+/// Stores data by key. The live implementation is in the `Persistence` package.
+public protocol KeyValueStore: Sendable {
+    func data(forKey key: String) async throws -> Data?
+    /// Stores `data`, or removes the value when `data` is `nil`.
+    func set(_ data: Data?, forKey key: String) async throws
+}
+
+public enum KeyValueStoreError: Error, Equatable, Sendable {
+    case invalidKey
+}
+
+extension KeyValueStoreError {
+    /// Rejects keys that could leave the store folder: a key has 1 to 128 letters, digits, `.`, `_`, or `-`,
+    /// and does not start with `.`.
+    public static func validate(_ key: String) throws(KeyValueStoreError) {
+        let allowed = Set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")
+        guard (1...128).contains(key.count), key.first != ".", key.allSatisfy(allowed.contains) else {
+            throw .invalidKey
+        }
+    }
+}
diff --git a/Packages/Core/Sources/CoreClients/Seams.swift b/Packages/Core/Sources/CoreClients/Seams.swift
new file mode 100644
index 0000000..f3925e5
--- /dev/null
+++ b/Packages/Core/Sources/CoreClients/Seams.swift
@@ -0,0 +1,115 @@
+import Foundation
+import os
+
+// Each cross-cutting seam is a protocol with a safe default. The shell builds the live values.
+
+// MARK: Entitlements
+
+public protocol EntitlementService: Sendable {
+    func isEntitled(toProduct productID: String) async -> Bool
+}
+
+/// Entitled in debug builds. Denied in release builds until a StoreKit service verifies a transaction.
+public struct DefaultEntitlements: EntitlementService {
+    private let grantAll: Bool
+    public init(grantAll: Bool) { self.grantAll = grantAll }
+    public func isEntitled(toProduct productID: String) async -> Bool { grantAll }
+}
+
+// MARK: Authentication
+
+public enum AuthState: Equatable, Sendable {
+    case signedOut
+    case signedIn(userID: String)
+}
+
+public protocol AuthClient: Sendable {
+    func state() async -> AuthState
+    func signOut() async
+}
+
+/// Signed out; signing out does nothing.
+public struct SignedOutAuthClient: AuthClient {
+    public init() {}
+    public func state() async -> AuthState { .signedOut }
+    public func signOut() async {}
+}
+
+// MARK: Analytics
+
+/// Every analytics event. Events carry no personal data.
+public enum AnalyticsEvent: Equatable, Sendable {
+    case featureOpened(featureID: String)
+}
+
+public protocol AnalyticsClient: Sendable {
+    func track(_ event: AnalyticsEvent)
+}
+
+public struct NoOpAnalytics: AnalyticsClient {
+    public init() {}
+    public func track(_ event: AnalyticsEvent) {}
+}
+
+// MARK: Feature flags
+
+/// A flag with its compiled default. Make the default the safe value.
+public struct FeatureFlag: Hashable, Sendable {
+    public let name: String
+    public let defaultValue: Bool
+    public init(name: String, defaultValue: Bool) {
+        self.name = name
+        self.defaultValue = defaultValue
+    }
+}
+
+public protocol FeatureFlagProvider: Sendable {
+    func isEnabled(_ flag: FeatureFlag) -> Bool
+}
+
+/// Returns the compiled default of each flag.
+public struct CompiledFeatureFlags: FeatureFlagProvider {
+    public init() {}
+    public func isEnabled(_ flag: FeatureFlag) -> Bool { flag.defaultValue }
+}
+
+// MARK: Diagnostics
+
+/// Every diagnostic event. Typed cases keep personal data and payloads out of the logs.
+public enum DiagnosticEvent: Equatable, Sendable {
+    case httpResponse(requestID: String, status: Int)
+    case httpTransportFailure(requestID: String, code: Int)
+}
+
+public protocol DiagnosticsClient: Sendable {
+    func record(_ event: DiagnosticEvent)
+}
+
+/// Logs with `os.Logger`: 1 subsystem for the app, 1 category for each module.
+public struct OSLogDiagnostics: DiagnosticsClient {
+    private let subsystem: String
+    public init(subsystem: String) { self.subsystem = subsystem }
+
+    public func record(_ event: DiagnosticEvent) {
+        switch event {
+        case let .httpResponse(requestID, status):
+            Logger(subsystem: subsystem, category: "Networking")
+                .info("http.response requestID=\(requestID, privacy: .public) status=\(status, privacy: .public)")
+        case let .httpTransportFailure(requestID, code):
+            Logger(subsystem: subsystem, category: "Networking")
+                .error("http.transport_failure requestID=\(requestID, privacy: .public) code=\(code, privacy: .public)")
+        }
+    }
+}
+
+// MARK: Notifications
+
+public protocol NotificationClient: Sendable {
+    /// Asks for permission. Call it at the moment the user needs the feature, not at launch.
+    func requestAuthorization() async -> Bool
+}
+
+public struct NoOpNotificationClient: NotificationClient {
+    public init() {}
+    public func requestAuthorization() async -> Bool { false }
+}
diff --git a/Packages/Core/Sources/CoreTesting/Fakes.swift b/Packages/Core/Sources/CoreTesting/Fakes.swift
new file mode 100644
index 0000000..f52b854
--- /dev/null
+++ b/Packages/Core/Sources/CoreTesting/Fakes.swift
@@ -0,0 +1,103 @@
+import CoreClients
+import FeatureKit
+import Foundation
+import os
+
+/// A clock that does not wait. `sleep` returns at once, or throws when the task is cancelled.
+public struct ImmediateClock: Clock {
+    public struct Instant: InstantProtocol {
+        public let offset: Duration
+        public init(offset: Duration = .zero) { self.offset = offset }
+        public func advanced(by duration: Duration) -> Instant { Instant(offset: offset + duration) }
+        public func duration(to other: Instant) -> Duration { other.offset - offset }
+        public static func < (lhs: Instant, rhs: Instant) -> Bool { lhs.offset < rhs.offset }
+    }
+
+    public init() {}
+    public var now: Instant { Instant() }
+    public var minimumResolution: Duration { .zero }
+    public func sleep(until deadline: Instant, tolerance: Duration?) async throws {
+        try Task.checkCancellation()
+    }
+}
+
+extension UUIDGenerator {
+    /// Makes 00000000-0000-0000-0000-000000000000, then ...0001, and so on.
+    public static func incrementing() -> UUIDGenerator {
+        let counter = OSAllocatedUnfairLock(initialState: 0)
+        return UUIDGenerator {
+            let value = counter.withLock { count in
+                defer { count += 1 }
+                return count
+            }
+            var bytes = [UInt8](repeating: 0, count: 16)
+            withUnsafeBytes(of: UInt64(value).bigEndian) { bytes.replaceSubrange(8..<16, with: $0) }
+            return bytes.withUnsafeBytes { UUID(uuid: $0.load(as: uuid_t.self)) }
+        }
+    }
+}
+
+/// Answers each path from a fixed table of JSON bodies. Unknown paths fail with status 404.
+public struct FakeHTTPClient: HTTPClient {
+    private let responses: [String: Data]
+    public init(responses: [String: Data] = [:]) { self.responses = responses }
+
+    public func send<Response: Decodable & Sendable>(_ endpoint: Endpoint<Response>) async throws -> Response {
+        guard let body = responses[endpoint.path] else { throw HTTPError.status(404) }
+        do {
+            return try JSONDecoder().decode(Response.self, from: body)
+        } catch {
+            throw HTTPError.malformedBody
+        }
+    }
+}
+
+/// Keeps values in memory, with the same key rules as the live store.
+public actor InMemoryKeyValueStore: KeyValueStore {
+    private var values: [String: Data]
+    public init(values: [String: Data] = [:]) { self.values = values }
+
+    public func data(forKey key: String) throws -> Data? {
+        try KeyValueStoreError.validate(key)
+        return values[key]
+    }
+
+    public func set(_ data: Data?, forKey key: String) throws {
+        try KeyValueStoreError.validate(key)
+        values[key] = data
+    }
+}
+
+/// Entitled to the given products only.
+public struct FakeEntitlements: EntitlementService {
+    private let products: Set<String>
+    public init(products: Set<String> = []) { self.products = products }
+    public func isEntitled(toProduct productID: String) async -> Bool { products.contains(productID) }
+}
+
+/// Discards every diagnostic event.
+public struct NoOpDiagnostics: DiagnosticsClient {
+    public init() {}
+    public func record(_ event: DiagnosticEvent) {}
+}
+
+extension Services {
+    /// Services for tests and previews: fakes and safe defaults, with no network and no disk.
+    public static func fake(
+        http: any HTTPClient = FakeHTTPClient(),
+        store: any KeyValueStore = InMemoryKeyValueStore(),
+        entitlements: any EntitlementService = FakeEntitlements(),
+        analytics: any AnalyticsClient = NoOpAnalytics(),
+        flags: any FeatureFlagProvider = CompiledFeatureFlags(),
+        diagnostics: any DiagnosticsClient = NoOpDiagnostics(),
+        auth: any AuthClient = SignedOutAuthClient(),
+        notifications: any NotificationClient = NoOpNotificationClient(),
+        clock: any Clock<Duration> = ImmediateClock(),
+        uuid: UUIDGenerator = .incrementing()
+    ) -> Services {
+        Services(
+            http: http, store: store, entitlements: entitlements, analytics: analytics, flags: flags,
+            diagnostics: diagnostics, auth: auth, notifications: notifications, clock: clock, uuid: uuid
+        )
+    }
+}
diff --git a/Packages/Core/Sources/FeatureKit/Feature.swift b/Packages/Core/Sources/FeatureKit/Feature.swift
new file mode 100644
index 0000000..d488db3
--- /dev/null
+++ b/Packages/Core/Sources/FeatureKit/Feature.swift
@@ -0,0 +1,88 @@
+import CoreClients
+import SwiftUI
+
+public struct FeatureID: Hashable, Codable, Sendable {
+    public let rawValue: String
+    public init(_ rawValue: String) { self.rawValue = rawValue }
+}
+
+public struct FeatureMetadata: Sendable {
+    public let title: LocalizedStringResource
+    public let systemImage: String
+    public init(title: LocalizedStringResource, systemImage: String) {
+        self.title = title
+        self.systemImage = systemImage
+    }
+}
+
+/// What the shell checks before it shows a feature. Feature and domain code never check purchases.
+public enum EntitlementRequirement: Equatable, Sendable {
+    case none
+    case product(String)
+}
+
+/// Every service a feature can use. Only the composition root builds the live values.
+public struct Services: Sendable {
+    public let http: any HTTPClient
+    public let store: any KeyValueStore
+    public let entitlements: any EntitlementService
+    public let analytics: any AnalyticsClient
+    public let flags: any FeatureFlagProvider
+    public let diagnostics: any DiagnosticsClient
+    public let auth: any AuthClient
+    public let notifications: any NotificationClient
+    public let clock: any Clock<Duration>
+    public let uuid: UUIDGenerator
+
+    public init(
+        http: any HTTPClient,
+        store: any KeyValueStore,
+        entitlements: any EntitlementService,
+        analytics: any AnalyticsClient,
+        flags: any FeatureFlagProvider,
+        diagnostics: any DiagnosticsClient,
+        auth: any AuthClient,
+        notifications: any NotificationClient,
+        clock: any Clock<Duration>,
+        uuid: UUIDGenerator
+    ) {
+        self.http = http
+        self.store = store
+        self.entitlements = entitlements
+        self.analytics = analytics
+        self.flags = flags
+        self.diagnostics = diagnostics
+        self.auth = auth
+        self.notifications = notifications
+        self.clock = clock
+        self.uuid = uuid
+    }
+}
+
+public struct FeatureContext: Sendable {
+    public let services: Services
+    public init(services: Services) { self.services = services }
+}
+
+/// The contract between a feature package and the shell. Conform 1 `XEntry` type in each feature.
+public protocol Feature: Sendable {
+    var id: FeatureID { get }
+    var metadata: FeatureMetadata { get }
+    var requirement: EntitlementRequirement { get }
+    @MainActor func makeRootView(context: FeatureContext) -> AnyView
+}
+
+/// The composition root builds the registry once. The shell renders navigation from the registry only.
+public struct FeatureRegistry: Sendable {
+    public private(set) var features: [any Feature] = []
+    public init() {}
+
+    public mutating func register(_ feature: any Feature) {
+        precondition(!features.contains { $0.id == feature.id }, "Duplicate FeatureID")
+        features.append(feature)
+    }
+
+    public func feature(for id: FeatureID) -> (any Feature)? {
+        features.first { $0.id == id }
+    }
+}
