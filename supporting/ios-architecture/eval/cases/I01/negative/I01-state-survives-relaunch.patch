diff --git a/Packages/Features/Packing/Sources/PackingFeature/PackingModel.swift b/Packages/Features/Packing/Sources/PackingFeature/PackingModel.swift
new file mode 100644
index 0000000..d7ebd41
--- /dev/null
+++ b/Packages/Features/Packing/Sources/PackingFeature/PackingModel.swift
@@ -0,0 +1,86 @@
+import CoreClients
+import Foundation
+import Observation
+import PackingDomain
+
+@Observable
+final class PackingModel {
+    static let storeKey = "packing-list.json"
+
+    private(set) var state = PackingState()
+    private(set) var errorMessage: LocalizedStringResource?
+    private(set) var hasLoaded = false
+    private let uuid: UUIDGenerator
+    private let store: any KeyValueStore
+    /// Saves run 1 after another, so that an older snapshot never overwrites a newer one.
+    private var lastSave: Task<Void, Never>?
+
+    init(uuid: UUIDGenerator, store: any KeyValueStore) {
+        self.uuid = uuid
+        self.store = store
+    }
+
+    func load() async {
+        guard !hasLoaded else { return }
+        do {
+            if let data = try await store.data(forKey: Self.storeKey) {
+                state = try PackingSnapshot.decode(data)
+            }
+            errorMessage = nil
+        } catch {
+            errorMessage = Self.loadFailed
+        }
+        hasLoaded = true
+    }
+
+    /// Returns `true` when the item was added. On failure, `errorMessage` says how to recover.
+    @discardableResult
+    func addItem(title: String) -> Bool {
+        do {
+            let item = try PackingItem.make(id: uuid(), title: title)
+            apply(.add(item))
+            errorMessage = nil
+            return true
+        } catch {
+            errorMessage = Self.message(for: error)
+            return false
+        }
+    }
+
+    func togglePacked(id: UUID) { apply(.togglePacked(id: id)) }
+
+    func removeItems(at offsets: IndexSet) {
+        for id in offsets.map({ state.items[$0].id }) {
+            apply(.remove(id: id))
+        }
+    }
+
+    /// Waits for every pending save. Tests call it before they read the store.
+    func waitForSaves() async { await lastSave?.value }
+
+    private func apply(_ action: PackingAction) {
+        state = PackingDomain.reduce(state, action)
+        let snapshot = state
+        let previous = lastSave
+        lastSave = Task { [store] in
+            await previous?.value
+            do {
+                try await store.set(PackingSnapshot.encode(snapshot), forKey: Self.storeKey)
+            } catch {
+                errorMessage = Self.saveFailed
+            }
+        }
+    }
+
+    static func message(for error: PackingError) -> LocalizedStringResource {
+        switch error {
+        case .emptyTitle:
+            LocalizedStringResource("Enter an item name.", bundle: .atURL(Bundle.module.bundleURL))
+        }
+    }
+
+    static let loadFailed = LocalizedStringResource(
+        "Could not open your packing list.", bundle: .atURL(Bundle.module.bundleURL))
+    static let saveFailed = LocalizedStringResource(
+        "Could not save your last change. Try again.", bundle: .atURL(Bundle.module.bundleURL))
+}
