@@ -0,0 +1,75 @@
+import CoreClients
+import DesignSystem
+import SwiftUI
+import PackingDomain
+
+struct PackingView: View {
+    @State var model: PackingModel
+    @State private var draft = ""
+    @AccessibilityFocusState private var isErrorFocused: Bool
+
+    var body: some View {
+        List {
+            Section {
+                TextField(text: $draft) { Text("Item name", bundle: .module) }
+                    .onSubmit(add)
+                Button(action: add) { Text("Add item", bundle: .module) }
+                if let message = model.errorMessage {
+                    InlineErrorMessage(message)
+                        .accessibilityFocused($isErrorFocused)
+                }
+            }
+            Section {
+                if model.hasLoaded && model.state.items.isEmpty {
+                    Text("Nothing to pack yet.", bundle: .module)
+                        .foregroundStyle(.secondary)
+                }
+                ForEach(model.state.items) { item in
+                    PackingRow(item: item) { model.togglePacked(id: item.id) }
+                }
+                .onDelete(perform: model.removeItems)
+            }
+        }
+        .navigationTitle(Text("Packing list", bundle: .module))
+    }
+
+    private func add() {
+        if model.addItem(title: draft) {
+            draft = ""
+        } else {
+            isErrorFocused = true
+        }
+    }
+}
+
+/// 1 accessibility element per item: the label is the item name, the value says whether it is packed.
+private struct PackingRow: View {
+    let item: PackingItem
+    let toggle: () -> Void
+
+    var body: some View {
+        Button(action: toggle) {
+            Label {
+                Text(item.title)
+                    .foregroundStyle(.primary)
+            } icon: {
+                Image(systemName: item.isPacked ? "checkmark.circle.fill" : "circle")
+                    .accessibilityHidden(true)
+            }
+        }
+        .accessibilityLabel(Text(item.title))
+        .accessibilityValue(item.isPacked ? Text("Packed", bundle: .module) : Text("Not packed", bundle: .module))
+        .accessibilityHint(Text("Changes whether the item is packed.", bundle: .module))
+    }
+}
+
+#Preview {
+    NavigationStack {
+        PackingView(model: PackingModel(uuid: .live, store: PreviewStore()))
+    }
+}
+
+private actor PreviewStore: KeyValueStore {
+    func data(forKey key: String) throws -> Data? { nil }
+    func set(_ data: Data?, forKey key: String) throws {}
+}
