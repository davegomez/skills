new file mode 100644
index 0000000..0ba506b
--- /dev/null
+++ b/Packages/Features/Packing/Sources/PackingDomain/PackingDomain.swift
@@ -0,0 +1,77 @@
+import Foundation
+
+public struct PackingItem: Identifiable, Equatable, Codable, Sendable {
+    public let id: UUID
+    public let title: String
+    public var isPacked: Bool
+
+    public init(id: UUID, title: String, isPacked: Bool = false) {
+        self.id = id
+        self.title = title
+        self.isPacked = isPacked
+    }
+
+    /// Trims the title, and rejects a title with no characters left. A new item is not packed.
+    public static func make(id: UUID, title: String) throws(PackingError) -> PackingItem {
+        let trimmed = title.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { throw .emptyTitle }
+        return PackingItem(id: id, title: trimmed)
+    }
+}
+
+/// Expected failures. The feature layer maps each case to a user-facing message.
+public enum PackingError: Error, Equatable, Sendable {
+    case emptyTitle
+}
+
+public struct PackingState: Equatable, Codable, Sendable {
+    public var items: [PackingItem]
+    public init(items: [PackingItem] = []) { self.items = items }
+}
+
+public enum PackingAction: Equatable, Sendable {
+    case add(PackingItem)
+    case togglePacked(id: UUID)
+    case remove(id: UUID)
+}
+
+/// The pure reducer. Invariant: each item ID appears at most once.
+public func reduce(_ state: PackingState, _ action: PackingAction) -> PackingState {
+    var next = state
+    switch action {
+    case .add(let item):
+        if !next.items.contains(where: { $0.id == item.id }) { next.items.append(item) }
+    case .togglePacked(let id):
+        if let index = next.items.firstIndex(where: { $0.id == id }) { next.items[index].isPacked.toggle() }
+    case .remove(let id):
+        next.items.removeAll { $0.id == id }
+    }
+    return next
+}
+
+/// The stored form of the list. The version lets a later release migrate old files.
+public struct PackingSnapshot: Equatable, Codable, Sendable {
+    public static let currentVersion = 1
+    public var version: Int
+    public var state: PackingState
+
+    public init(state: PackingState) {
+        version = Self.currentVersion
+        self.state = state
+    }
+
+    public static func encode(_ state: PackingState) throws -> Data {
+        try JSONEncoder().encode(PackingSnapshot(state: state))
+    }
+
+    /// Rejects a file from a newer release instead of reading it wrongly.
+    public static func decode(_ data: Data) throws -> PackingState {
+        let snapshot = try JSONDecoder().decode(PackingSnapshot.self, from: data)
+        guard snapshot.version <= currentVersion else { throw SnapshotError.unsupportedVersion(snapshot.version) }
+        return snapshot.state
+    }
+}
+
+public enum SnapshotError: Error, Equatable, Sendable {
+    case unsupportedVersion(Int)
+}
