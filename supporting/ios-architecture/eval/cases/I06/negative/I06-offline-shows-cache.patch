+++ b/Shelf/ReadingList/BookCache.swift
@@ -0,0 +1,30 @@
+import Foundation
+import os
+
+/// Last list the server returned, kept for offline display.
+nonisolated struct BookCache: Sendable {
+    let fileURL: URL
+    private static let log = Logger(subsystem: "eval.i06.Shelf", category: "ReadingList")
+
+    static let standard = BookCache(fileURL: URL.cachesDirectory.appending(path: "reading-list.json"))
+
+    func load() -> [Book]? {
+        do {
+            return try JSONDecoder().decode([Book].self, from: Data(contentsOf: fileURL))
+        } catch CocoaError.fileReadNoSuchFile {
+            return nil
+        } catch {
+            Self.log.error("Reading list cache unreadable: \(String(describing: type(of: error)), privacy: .public)")
+            return nil
+        }
+    }
+
+    func save(_ books: [Book]) {
+        do {
+            let data = try JSONEncoder().encode(books)
+            try data.write(to: fileURL, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+        } catch {
+            Self.log.error("Reading list cache not saved: \(String(describing: type(of: error)), privacy: .public)")
+        }
+    }
+}
diff --git a/Shelf/ReadingList/BooksRepository.swift b/Shelf/ReadingList/BooksRepository.swift
new file mode 100644
index 0000000..9214517
--- /dev/null
+++ b/Shelf/ReadingList/BooksRepository.swift
@@ -0,0 +1,68 @@
+import Foundation
+import os
+
+/// Loads the reading list over the authenticated transport, with retries and an offline cache.
+nonisolated struct BooksRepository: Sendable {
+    enum Outcome: Equatable, Sendable {
+        case fresh([Book])
+        case cached([Book])
+    }
+
+    let http: any HTTPClient
+    let auth: any AuthService
+    let cache: BookCache
+    var policy = RetryPolicy()
+    private static let log = Logger(subsystem: "eval.i06.Shelf", category: "ReadingList")
+    private static let maxBodySize = 1_000_000
+
+    /// Throws `CancellationError` when cancelled and `LoadFailure` when the load fails.
+    func load() async throws -> Outcome {
+        var attempt = 1
+        while true {
+            let requestID = UUID().uuidString
+            do {
+                let books = try await fetchOnce(requestID: requestID)
+                cache.save(books)
+                return .fresh(books)
+            } catch let failure as LoadFailure {
+                Self.log.error("Books request \(requestID, privacy: .public) attempt \(attempt, privacy: .public) failed: \(String(describing: failure), privacy: .public)")
+                switch failure {
+                case .transient where attempt < policy.maxAttempts:
+                    try await Task.sleep(for: policy.delay(afterAttempt: attempt))
+                    attempt += 1
+                case .offline, .transient, .permanent:
+                    throw failure
+                }
+            }
+        }
+    }
+
+    private func fetchOnce(requestID: String) async throws -> [Book] {
+        var request = URLRequest(url: ShelfAPI.baseURL.appending(path: "books"))
+        request.httpMethod = "GET"
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        request.setValue(requestID, forHTTPHeaderField: "X-Request-ID")
+        request.setValue("Bearer \(try await auth.accessToken())", forHTTPHeaderField: "Authorization")
+
+        let data: Data
+        let response: URLResponse
+        do {
+            (data, response) = try await http.data(for: request)
+        } catch let error as URLError where error.code == .cancelled {
+            throw CancellationError()
+        } catch let error as URLError {
+            throw LoadFailure.classify(error)
+        }
+
+        guard let http = response as? HTTPURLResponse else { throw LoadFailure.permanent }
+        if let failure = LoadFailure.classify(status: http.statusCode) { throw failure }
+        guard http.mimeType == "application/json", data.count <= Self.maxBodySize else {
+            throw LoadFailure.permanent
+        }
+        do {
+            return try JSONDecoder().decode(BookListResponse.self, from: data).books
+        } catch {
+            throw LoadFailure.permanent
+        }
+    }
+}
diff --git a/Shelf/ReadingList/LoadPolicy.swift b/Shelf/ReadingList/LoadPolicy.swift
new file mode 100644
index 0000000..010c66c
--- /dev/null
+++ b/Shelf/ReadingList/LoadPolicy.swift
@@ -0,0 +1,39 @@
+import Foundation
+
+/// Why a load failed, in the terms the reading list shows.
+nonisolated enum LoadFailure: Error, Equatable, Sendable {
+    case offline
+    case transient
+    case permanent
+
+    static func classify(status: Int) -> LoadFailure? {
+        switch status {
+        case 200...299: nil
+        case 408, 429, 500...599: .transient
+        default: .permanent
+        }
+    }
+
+    static func classify(_ error: URLError) -> LoadFailure {
+        switch error.code {
+        case .notConnectedToInternet, .dataNotAllowed, .internationalRoamingOff:
+            .offline
+        case .timedOut, .networkConnectionLost, .cannotConnectToHost, .cannotFindHost, .dnsLookupFailed:
+            .transient
+        default:
+            .permanent
+        }
+    }
+}
+
+/// Retry rules for idempotent requests.
+nonisolated struct RetryPolicy: Sendable {
+    var maxAttempts = 3
+    var baseDelay: Duration = .milliseconds(200)
+
+    /// Exponential backoff with up to 50% jitter.
+    func delay(afterAttempt attempt: Int) -> Duration {
+        let base = baseDelay * (1 << (attempt - 1))
+        return base + base * Double.random(in: 0...0.5)
+    }
+}
