+++ b/Shelf/ReadingList/ReadingListModel.swift
@@ -0,0 +1,35 @@
+import Observation
+
+@Observable
+final class ReadingListModel {
+    enum State: Equatable {
+        case loading
+        case loaded([Book])
+        case empty
+        case offline([Book])
+        case failed
+    }
+
+    private(set) var state: State = .loading
+    private let repository: BooksRepository
+
+    init(repository: BooksRepository) {
+        self.repository = repository
+    }
+
+    func load() async {
+        state = .loading
+        do {
+            switch try await repository.load() {
+            case .fresh(let books):
+                state = books.isEmpty ? .empty : .loaded(books)
+            case .cached(let books):
+                state = .offline(books)
+            }
+        } catch is CancellationError {
+            // The screen went away; there is nothing to show.
+        } catch {
+            state = .failed
+        }
+    }
+}
