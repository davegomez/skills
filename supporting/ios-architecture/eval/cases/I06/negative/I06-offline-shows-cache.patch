 import SwiftUI
 
 struct ReadingListView: View {
-    let dependencies: AppDependencies
+    @State private var model: ReadingListModel
+    @State private var loadID = 0
+
+    init(dependencies: AppDependencies) {
+        let repository = BooksRepository(http: dependencies.http, auth: dependencies.auth, cache: .standard)
+        _model = State(initialValue: ReadingListModel(repository: repository))
+    }
 
     var body: some View {
-        ContentUnavailableView("Coming Soon", systemImage: "books.vertical")
+        content
             .navigationTitle("Reading List")
+            .task(id: loadID) { await model.load() }
+    }
+
+    @ViewBuilder
+    private var content: some View {
+        switch model.state {
+        case .loading:
+            ProgressView("Loading books")
+                .accessibilityIdentifier("reading.loading")
+        case .loaded(let books):
+            bookList(books, offline: false)
+        case .empty:
+            ContentUnavailableView("No books yet", systemImage: "books.vertical")
+                .accessibilityIdentifier("reading.empty")
+        case .offline(let books):
+            bookList(books, offline: true)
+        case .failed:
+            ContentUnavailableView {
+                Label("Could not load your reading list.", systemImage: "exclamationmark.triangle")
+                    .accessibilityIdentifier("reading.error")
+            } actions: {
+                Button("Try Again") { loadID += 1 }
+                    .buttonStyle(.borderedProminent)
+                    .accessibilityIdentifier("reading.retry")
+            }
+        }
+    }
+
+    private func bookList(_ books: [Book], offline: Bool) -> some View {
+        List {
+            if offline {
+                Label("You are offline. Showing saved books.", systemImage: "wifi.slash")
+                    .accessibilityIdentifier("reading.offline")
+            }
+            ForEach(books) { book in
+                VStack(alignment: .leading) {
+                    Text(book.title)
+                        .font(.headline)
+                    Text(book.author)
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+                }
+                .accessibilityElement(children: .combine)
+            }
+        }
+        .accessibilityIdentifier("reading.list")
     }
 }
