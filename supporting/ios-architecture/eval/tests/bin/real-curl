#!/usr/bin/env python3
"""Fake transport behind the curl wrapper: answers 200 with a Jev-like body. Records only whether an
Authorization header arrived on stdin (never its value), so a test can prove the key reached the transport."""
import json, os, sys

args = sys.argv[1:]
cfg = sys.stdin.read() if "--config" in args else ""
home = os.environ["HOME"]
with open(os.path.join(home, "curl-seen.txt"), "a") as f:
    f.write("header=%s\n" % ("yes" if "Authorization: Bearer " in cfg else "no"))
model = json.load(open(os.path.join(home, "fake-claude.json"))).get("jev_model", "jev-test-1")
if "-o" in args:
    open(args[args.index("-o") + 1], "w").write(json.dumps({"model": model, "answers": {}}))
sys.stdout.write("200")
